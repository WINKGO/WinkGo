{
  "name": "wink-go",
  "version": "2.2.23",
  "private": true,
  "description": "WINK GO — a local-first AI agent workspace for agents, models, skills, MCP, files, automation, and Dynamic Island.",
  "keywords": [
    "acp",
    "agent-workspace",
    "ai-agent",
    "desktop-app",
    "dynamic-island",
    "electron",
    "local-first",
    "mcp",
    "multi-agent",
    "rust"
  ],
  "homepage": "https://github.com/WINKGO/wink-go",
  "bugs": {
    "url": "https://github.com/WINKGO/wink-go/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "WINK GO",
    "url": "https://winkgo.top/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WINKGO/wink-go.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "dev:pro": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=pro WINKGO_ALLOW_PRO_DEV_BUILD=1 electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start:multi": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free WINKGO_MULTI_INSTANCE=1 electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "cli": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "webui": "tsx scripts/webui.ts",
    "webui:remote": "tsx scripts/webui.ts --remote",
    "webui:prod": "cross-env NODE_ENV=production tsx scripts/webui.ts",
    "webui:prod:remote": "cross-env NODE_ENV=production tsx scripts/webui.ts --remote",
    "resetpass": "tsx scripts/resetpass.ts",
    "package": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free electron-vite build --config packages/desktop/electron.vite.config.ts",
    "brand:installer-assets": "node scripts/generate-winkgo-installer-assets.js",
    "release:privacy:audit": "node scripts/audit-release-privacy.cjs --stage",
    "release:privacy:audit:packed": "node scripts/audit-release-privacy.cjs --packed",
    "release:migrations:audit": "node scripts/verify-database-migrations.cjs",
    "security:audit": "node scripts/security/audit-dependencies.cjs",
    "licenses:generate": "node scripts/licenses/generate-third-party-licenses.cjs",
    "licenses:check": "node scripts/licenses/generate-third-party-licenses.cjs --check",
    "licenses:check:locks": "node scripts/licenses/generate-third-party-licenses.cjs --check-locks",
    "licenses:check:upstream": "node scripts/licenses/verify-upstream-attribution.cjs",
    "release:website:prepare": "cross-env WINKGO_EDITION=free node scripts/generate-winkgo-update-manifest.js",
    "make": "node scripts/build-mcp-servers.js && cross-env WINKGO_EDITION=free electron-vite build --config packages/desktop/electron.vite.config.ts",
    "dist": "node scripts/build-with-builder.js auto --edition free",
    "dist:mac": "node scripts/build-with-builder.js auto --mac --edition free",
    "dist:win": "node scripts/build-with-builder.js auto --win --edition free",
    "dist:win:free": "node scripts/build-with-builder.js auto --win --edition free",
    "dist:win:pro:dev": "node scripts/build-with-builder.js auto --win --edition pro --allow-pro-dev",
    "dist:linux": "node scripts/build-with-builder.js auto --linux --edition free",
    "build-mac": "node scripts/build-with-builder.js auto --mac --arm64 --x64 --edition free",
    "build-win": "node scripts/build-with-builder.js auto --win --edition free",
    "build-deb": "node scripts/build-with-builder.js auto --linux --edition free",
    "build-mac:arm64": "node scripts/build-with-builder.js arm64 --mac --arm64 --edition free",
    "build-mac:x64": "node scripts/build-with-builder.js x64 --mac --x64 --edition free",
    "build-win:arm64": "node scripts/build-with-builder.js arm64 --win --arm64 --edition free",
    "build-win:x64": "node scripts/build-with-builder.js x64 --win --x64 --edition free",
    "build-win:x64:free": "node scripts/build-with-builder.js x64 --win --x64 --edition free",
    "build-win:x64:pro:dev": "node scripts/build-with-builder.js x64 --win --x64 --edition pro --allow-pro-dev",
    "build-win:x64:fast": "cross-env ELECTRON_BUILDER_COMPRESSION_LEVEL=1 node scripts/build-with-builder.js x64 --win --x64 --edition free --config.win.signAndEditExecutable=false",
    "build-win:x64:debug-versions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fast-debug-versions.ps1",
    "build": "node scripts/build-with-builder.js auto --mac --arm64 --x64 --edition free",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "test:packaged:i18n": "vitest run tests/integration/i18n-packaged.test.ts",
    "bench": "vitest bench",
    "bench:db": "bun test ./tests/bench/database.bench.bun.ts",
    "bench:report": "bunx tsx scripts/run-benchmarks.ts",
    "bench:startup": "bunx tsx scripts/benchmark-startup.ts",
    "bench:full": "bunx tsx scripts/run-benchmarks.ts --startup",
    "debug:perf": "cross-env ACP_PERF=1 PERF_MONITOR=1 bun start",
    "debug:perf:report": "bunx tsx scripts/debug-performance.ts --report",
    "debug:mcp": "bunx tsx scripts/debug-mcp.ts",
    "debug:mcp:list": "bunx tsx scripts/debug-mcp.ts list",
    "debug:mcp:validate": "bunx tsx scripts/debug-mcp.ts validate",
    "debug:custom-agent": "bunx tsx scripts/debug-custom-agent.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:team": "playwright test --config playwright.config.ts tests/e2e/cases/teams/*.e2e.ts --reporter=list",
    "test:e2e:team:create": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-create.e2e.ts --reporter=list",
    "test:e2e:team:lifecycle": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-agent-lifecycle.e2e.ts --reporter=list",
    "test:e2e:team:whitelist": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-whitelist.e2e.ts --reporter=list",
    "test:e2e:team:comm": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-communication.e2e.ts --reporter=list",
    "test:e2e:installer:error-codes": "node scripts/smoke-installer-failure-messagebox.js --all-scenarios --auto-consent",
    "test:smoke:installer:failure-messagebox": "node scripts/smoke-installer-failure-messagebox.js",
    "test:smoke:installer:self-lock": "node scripts/smoke-installer-self-lock.js",
    "test:smoke:installer:rstrtmgr-ui": "node scripts/smoke-installer-rstrtmgr-ui.js",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "test:bun": "bun test packages/desktop/src/process/services/database/drivers/*.bun.test.ts"
  },
