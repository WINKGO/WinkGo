    {
      "id": "power",
      "phrases": [
        "打开",
        "关闭",
        "开灯",
        "关灯"
      ],
      "tool_names": [
        "homeassistant.turn_on",
        "homeassistant.turn_off",
        "homeassistant.toggle",
        "appliance.set_power"
      ],
      "default_arguments": {}
    },
    {
      "id": "temperature",
      "phrases": [
        "温度",
        "空调"
      ],
      "tool_names": [
        "homeassistant.set_climate_temperature",
        "appliance.set_temperature"
      ],
      "default_arguments": {}
    },
    {
