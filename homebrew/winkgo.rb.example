# Reference template only. WINK GO does not currently claim an official
# Homebrew cask. Replace the version and checksums when publishing one.

cask "winkgo" do
  arch arm: "arm64", intel: "x64"

  version "2.2.0"
  sha256 arm: :no_check, intel: :no_check

  url "https://github.com/xuweihafeichangniu-lab/wink-go/releases/download/v#{version}/WINK-GO-Free-#{version}-mac-#{arch}.dmg"
  name "WINK GO"
  desc "Desktop workspace for AI agents"
  homepage "https://github.com/xuweihafeichangniu-lab/wink-go"

  livecheck do
    url "https://github.com/xuweihafeichangniu-lab/wink-go"
    strategy :github_latest
  end

  depends_on macos: ">= :big_sur"

  app "WINK GO.app"

  # Preserve cleanup for data created by pre-WINK GO installations.
  zap trash: [
    "~/Library/Application Support/WINK GO",
    "~/Library/Preferences/com.winkgo.desktop.plist",
    "~/Library/Saved Application State/com.winkgo.desktop.savedState",
  ]
end
